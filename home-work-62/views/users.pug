doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    title Users
    style.
      body { font-family: Arial, sans-serif; max-width: 600px; margin: 40px auto; }
      h1 { color: #1a1a2e; }
      ul { list-style: none; padding: 0; }
      li { background: #f5f5f5; margin: 8px 0; padding: 12px; border-radius: 6px; }
      a { color: #007bff; text-decoration: none; }
  body
    h1 Users List
    ul
      each user in users
        li
          a(href=`/users/${user.id}`) #{user.name}
          span  — #{user.email}